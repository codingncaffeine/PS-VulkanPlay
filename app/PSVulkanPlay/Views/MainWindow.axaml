<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PSVulkanPlay.ViewModels"
        xmlns:core="using:PSVulkanPlay.Core"
        x:Class="PSVulkanPlay.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="PS VulkanPlay"
        Icon="avares://PSVulkanPlay/Assets/icon.png"
        Width="1120" Height="720" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <!-- The size setting scales everything, as a browser's zoom does: text, controls and spacing keep their proportions. -->
    <LayoutTransformControl x:Name="Scaler">
        <LayoutTransformControl.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Settings.ScaleFactor}" ScaleY="{Binding Settings.ScaleFactor}" />
        </LayoutTransformControl.LayoutTransform>
    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">

        <!-- ===== The top: what this is, and its pages ===== -->
        <Border Grid.Row="0" Padding="28,14,28,0" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                    <Image Source="avares://PSVulkanPlay/Assets/icon.png" Width="38" Height="38" />
                    <TextBlock VerticalAlignment="Center" FontSize="19" FontWeight="SemiBold">
                        <Run Text="PS" Foreground="{DynamicResource Accent}" /><Run Text=" VulkanPlay" />
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="NavHome" Classes="nav" Classes.here="{Binding IsHome}" Content="Consoles" Command="{Binding GoHome}" />
                    <Button x:Name="NavSettings" Classes="nav" Classes.here="{Binding IsSettings}" Content="Settings" Command="{Binding GoSettings}" />
                    <Button x:Name="NavDiagnostics" Classes="nav" Classes.here="{Binding IsDiagnostics}" Content="Diagnostics" Command="{Binding GoDiagnostics}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Consoles ===== -->
        <ScrollViewer x:Name="HomeScroll" Grid.Row="1" IsVisible="{Binding IsHome}" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,26,28,28">
                <Grid ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding !ShowEmpty}">
                    <TextBlock Classes="title" Text="Your consoles" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="quiet" Content="Look again" Command="{Binding RefreshNow}" />
                    <Button x:Name="AddButton" Grid.Column="2" Content="Add a console" Command="{Binding GoAddConsole}" Margin="8,0,0,0" />
                </Grid>

                <ItemsControl x:Name="Cards" ItemsSource="{Binding Consoles}" Margin="-9,18,-9,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ConsoleCard">
                            <Border Classes="card" Width="340" Margin="9">
                                <StackPanel>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="1" Classes="badge" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding Kind}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                                        </Border>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                                        <Panel Width="10" Height="10" VerticalAlignment="Center">
                                            <Ellipse Fill="{DynamicResource Good}" IsVisible="{Binding IsReady}" />
                                            <Ellipse Fill="{DynamicResource Resting}" IsVisible="{Binding IsResting}" />
                                            <Ellipse Fill="{DynamicResource Bad}" IsVisible="{Binding IsMissing}" />
                                            <Ellipse Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" IsVisible="{Binding IsLooking}" />
                                        </Panel>
                                        <TextBlock Text="{Binding StateText}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Classes="secondary small" Text="{Binding Detail}" Margin="18,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />

                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,22,0,0" IsVisible="{Binding !ConfirmForget}">
                                        <Button Classes="primary big" Content="Play" Command="{Binding Play}" />
                                        <Button Grid.Column="1" Content="Wake" Command="{Binding Wake}" IsVisible="{Binding !IsReady}" Margin="10,0,0,0" Padding="16,11" />
                                        <Button Grid.Column="3" Classes="quiet" Content="Forget" Command="{Binding AskForget}" />
                                    </Grid>
                                    <!-- One above the other: a controller moves up and down between them. -->
                                    <Button Classes="quiet" FontSize="13" Content="{Binding ShortcutText}" Command="{Binding ToggleShortcut}" Margin="-8,8,0,0" HorizontalAlignment="Left"
                                            IsVisible="{Binding !ConfirmForget}" ToolTip.Tip="An entry of its own in the desktop's application menu that starts a session with this console straight away, with these settings" />
                                    <Button Classes="quiet" FontSize="13" Content="{Binding SteamText}" Command="{Binding ToggleSteam}" Margin="-8,0,0,0" HorizontalAlignment="Left"
                                            ToolTip.Tip="A non-Steam game in Steam's library, with pictures, that starts a session with this console straight away, with these settings (Steam must be closed while it is added)">
                                        <Button.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="HasSteam" />
                                                <Binding Path="!ConfirmForget" />
                                            </MultiBinding>
                                        </Button.IsVisible>
                                    </Button>
                                    <StackPanel Margin="0,14,0,0" IsVisible="{Binding ConfirmForget}">
                                        <TextBlock Classes="secondary small" Text="Forget this console? To play on it again you would register with its PIN once more." />
                                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                                            <Button Content="Forget it" Command="{Binding Forget}" />
                                            <Button Classes="quiet" Content="Keep it" Command="{Binding CancelForget}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Nothing registered yet: the one thing to do. -->
                <Border Classes="card" IsVisible="{Binding ShowEmpty}" MaxWidth="560" Margin="0,40,0,0" Padding="36">
                    <StackPanel HorizontalAlignment="Center">
                        <Image Source="avares://PSVulkanPlay/Assets/icon.png" Width="96" Height="96" />
                        <TextBlock Classes="title" Text="No console yet" HorizontalAlignment="Center" Margin="0,14,0,0" />
                        <TextBlock Classes="secondary" TextAlignment="Center" Margin="0,8,0,0"
                                   Text="Register this computer with your PS5 or PS4 once. After that it shows up here, and Play is one press." />
                        <Button x:Name="AddFirst" Classes="primary big" Content="Add a console" Command="{Binding GoAddConsole}" HorizontalAlignment="Center" Margin="0,22,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Settings ===== -->
        <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" IsVisible="{Binding IsSettings}" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,26,28,28" MaxWidth="780" DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel" Spacing="18">
                <TextBlock Classes="title" Text="Settings" />

                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Classes="section" Text="Picture" />
                        <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="Size" /><TextBlock Classes="secondary small" Text="What the console sends; the window scales it." /></StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Resolutions}" SelectedItem="{Binding Resolution}" />
                        </Grid>
                        <Border Classes="rule" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Pictures" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding FrameRates}" SelectedItem="{Binding FrameRate}" />
                        </Grid>
                        <Border Classes="rule" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="Coding" /><TextBlock Classes="secondary small" Text="A PS4 always sends H.264." /></StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Codecs}" SelectedItem="{Binding Codec}" MinWidth="330" />
                        </Grid>
                        <Border Classes="rule" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="HDR brightness" />
                                <TextBlock Classes="secondary small" TextWrapping="Wrap"
                                           Text="With HDR coding: how bright the console's picture is at its brightest. The window shows it as SDR, with what is brighter than white paper fitted below white: higher keeps more detail in bright places, lower makes them brighter." />
                                <TextBlock Classes="secondary small" Text="{Binding HdrPeakText}" Foreground="{DynamicResource Accent}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Slider Grid.Column="1" Minimum="400" Maximum="4000" TickFrequency="100" IsSnapToTickEnabled="True" Value="{Binding HdrPeak}" />
                        </Grid>
                        <Border Classes="rule" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Scaling" />
                                <TextBlock Classes="secondary small" TextWrapping="Wrap" Text="How the picture is brought to the window's size. The sharper ones show more detail and take more of the graphics card." />
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Scalers}" SelectedItem="{Binding Scaler}" MinWidth="330" />
                        </Grid>
                        <Border Classes="rule" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Smooth out banding" />
                                <TextBlock Classes="secondary small" TextWrapping="Wrap" Text="A low bitrate cuts skies and other smooth areas into flat bands; this blends them back together and leaves edges alone." />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Deband}" OnContent="" OffContent="" MinWidth="0" />
                        </Grid>
                        <Border Classes="rule" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="Bitrate" /><TextBlock Classes="secondary small" Text="{Binding BitrateText}" /></StackPanel>
                            <!-- One above the other: left and right on a slider change its value, so a control beside one could not be reached with a controller. -->
                            <StackPanel Grid.Column="1">
                                <CheckBox Content="Automatic" IsChecked="{Binding AutoBitrate}" HorizontalAlignment="Right" />
                                <Slider Minimum="2" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding BitrateMbps}" IsEnabled="{Binding !AutoBitrate}" />
                            </StackPanel>
                        </Grid>
                        <Border Classes="rule" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="Decode on the graphics card" /><TextBlock Classes="secondary small" TextWrapping="Wrap" Text="Where the card can. Its first pictures are checked against software decoding, which takes over if they differ." /></StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding GpuDecoding}" OnContent="" OffContent="" MinWidth="0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Classes="section" Text="One console's picture" />
                        <TextBlock Classes="secondary small" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="A console can have a picture of its own: a lower size for the one on Wi-Fi, HEVC for the PS5 and H.264 for the PS4." />
                        <TextBlock Classes="secondary" Text="The consoles you add are listed here." Margin="0,14,0,0" IsVisible="{Binding !HasConsoles}" />
                        <StackPanel IsVisible="{Binding HasConsoles}">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                                <TextBlock Text="Console" VerticalAlignment="Center" />
                                <ComboBox x:Name="ConsolePictureConsole" Grid.Column="1" ItemsSource="{Binding ConsoleNames}" SelectedItem="{Binding ChosenConsole}" MinWidth="330" />
                            </Grid>
                            <Border Classes="rule" />
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="Its own picture" /><TextBlock Classes="secondary small" Text="Off: the picture above." /></StackPanel>
                                <ToggleSwitch x:Name="ConsoleOwnPictureSwitch" Grid.Column="1" IsChecked="{Binding ConsoleOwnPicture}" OnContent="" OffContent="" MinWidth="0" />
                            </Grid>
                            <Border Classes="rule" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Size" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Resolutions}" SelectedItem="{Binding ConsoleResolution}" IsEnabled="{Binding ConsoleOwnPicture}" MinWidth="330" />
                            </Grid>
                            <Border Classes="rule" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Pictures" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding FrameRates}" SelectedItem="{Binding ConsoleFrameRate}" IsEnabled="{Binding ConsoleOwnPicture}" MinWidth="330" />
                            </Grid>
                            <Border Classes="rule" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Coding" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Codecs}" SelectedItem="{Binding ConsoleCodec}" IsEnabled="{Binding ConsoleOwnPicture}" MinWidth="330" />
                            </Grid>
                            <Border Classes="rule" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="Bitrate" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Bitrates}" SelectedItem="{Binding ConsoleBitrate}" IsEnabled="{Binding ConsoleOwnPicture}" MinWidth="330" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Classes="section" Text="Smoothness" />
                        <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="Even pacing" /><TextBlock Classes="secondary small" Text="Shows pictures a frame's time apart, also when they arrive in bunches." /></StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Pacing}" OnContent="" OffContent="" MinWidth="0" />
                        </Grid>
                        <Border Classes="rule" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Cushion" />
                                <TextBlock Classes="secondary small" Text="Keeps a little delay so that short pauses of a wireless network do not show. 20 ms hides most of them." />
                                <TextBlock Classes="secondary small" Text="{Binding CushionText}" Foreground="{DynamicResource Accent}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Slider Grid.Column="1" Minimum="0" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Cushion}" IsEnabled="{Binding Pacing}" />
                        </Grid>
                        <Border Classes="rule" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="Loss told to the console" />
                                <TextBlock Classes="secondary small" Text="The console answers lost packets with a lower bitrate and fewer pictures, also for a short burst on a wireless network. Telling it less keeps the picture sharp." />
                                <TextBlock Classes="secondary small" Text="{Binding LossCeilingText}" Foreground="{DynamicResource Accent}" Margin="0,4,0,0" />
                            </StackPanel>
                            <Slider x:Name="LossCeilingSlider" Grid.Column="1" Minimum="0" Maximum="100" SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding LossCeiling}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Classes="section" Text="Controller" />
                        <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="The console is told it is" /><TextBlock Classes="secondary small" Text="Haptics and trigger effects are sent to a DualSense only." /></StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Controllers}" SelectedItem="{Binding Controller}" MinWidth="330" />
                        </Grid>
                        <Border Classes="rule" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="Haptics strength" /><TextBlock Classes="secondary small" Text="{Binding HapticsText}" /></StackPanel>
                            <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding HapticsVolume}" />
                        </Grid>
                        <Border Classes="rule" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="Left back button" /><TextBlock Classes="secondary small" Text="On a DualSense Edge: the console's button it presses." /></StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Buttons}" SelectedItem="{Binding BackLeft}" MinWidth="260" />
                        </Grid>
                        <Border Classes="rule" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Right back button" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Buttons}" SelectedItem="{Binding BackRight}" MinWidth="260" />
                        </Grid>
                        <Border Classes="rule" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="Left Fn button" /><TextBlock Classes="secondary small" Text="On a DualSense Edge: what it does while playing." /></StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding FnActions}" SelectedItem="{Binding FnLeft}" MinWidth="260" />
                        </Grid>
                        <Border Classes="rule" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Right Fn button" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding FnActions}" SelectedItem="{Binding FnRight}" MinWidth="260" />
                        </Grid>
                        <Border Classes="rule" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock Text="Adaptive trigger effects" /><TextBlock Classes="secondary small" TextWrapping="Wrap" Text="The resistance a game puts on a DualSense's triggers." /></StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding TriggerEffects}" OnContent="" OffContent="" MinWidth="0" />
                        </Grid>
                        <Border Classes="rule" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="Light bar" /><TextBlock Classes="secondary small" Text="Its color while playing." /></StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding LightBars}" SelectedItem="{Binding LightBar}" MinWidth="260" />
                        </Grid>
                        <Border Classes="rule" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="Player lights" /><TextBlock Classes="secondary small" Text="The lights under the touchpad that show which player you are." /></StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding PlayerLights}" OnContent="" OffContent="" MinWidth="0" />
                        </Grid>
                        <Border Classes="rule" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="Motion" /><TextBlock Classes="secondary small" Text="Tilting and turning the controller, for games that steer or aim with it." /></StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Motion}" OnContent="" OffContent="" MinWidth="0" />
                        </Grid>
                        <Border Classes="rule" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="Touchpad" /><TextBlock Classes="secondary small" Text="Touches on it; pressing it stays a button." /></StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Touchpad}" OnContent="" OffContent="" MinWidth="0" />
                        </Grid>
                        <Border Classes="rule" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center" Margin="0,0,20,0"><TextBlock Text="Stick dead zone" /><TextBlock Classes="secondary small" Text="{Binding DeadZoneText}" /></StackPanel>
                            <Slider Grid.Column="1" Minimum="0" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding DeadZone}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Classes="section" Text="Session" />
                        <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="Wake the console when Play is pressed" /><TextBlock Classes="secondary small" Text="From rest mode; it must stay connected to the network while it rests." /></StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding WakeFirst}" OnContent="" OffContent="" MinWidth="0" />
                        </Grid>
                        <Border Classes="rule" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="Reconnect by itself" /><TextBlock Classes="secondary small" Text="A connection lost while playing is made again, for up to a minute, over the last picture." /></StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding Reconnect}" OnContent="" OffContent="" MinWidth="0" />
                        </Grid>
                        <Border Classes="rule" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Send the console to rest mode when the session ends" VerticalAlignment="Center" />
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding RestAfter}" OnContent="" OffContent="" MinWidth="0" />
                        </Grid>
                        <Border Classes="rule" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="Show statistics while playing" /><TextBlock Classes="secondary small" Text="The picture's size and rate, decoding time and the console's view of the connection, over the picture. F3 shows and hides them at any time." /></StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding ShowStats}" OnContent="" OffContent="" MinWidth="0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="card">
                    <StackPanel>
                        <TextBlock Classes="section" Text="Look" />
                        <TextBlock Classes="secondary small" Text="Changes at once, for the whole app." Margin="0,4,0,14" />
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="Size of everything" /><TextBlock Classes="secondary small" Text="Text and controls together, for reading from the couch." /></StackPanel>
                            <ComboBox x:Name="ScaleChoice" Grid.Column="1" ItemsSource="{Binding Scales}" SelectedItem="{Binding Scale}" />
                        </Grid>
                        <ItemsControl x:Name="ThemeCards" ItemsSource="{Binding ThemeChoices}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ThemeChoice">
                                    <Button Classes="swatch" Classes.active="{Binding Active}" Command="{Binding Pick}">
                                        <Border CornerRadius="8" ClipToBounds="True">
                                            <Panel>
                                                <Grid ColumnDefinitions="*,*">
                                                    <Border><Border.Background><SolidColorBrush Color="{Binding Left}" /></Border.Background></Border>
                                                    <Border Grid.Column="1"><Border.Background><SolidColorBrush Color="{Binding Right}" /></Border.Background></Border>
                                                </Grid>
                                                <StackPanel VerticalAlignment="Bottom" Margin="11,0,8,9">
                                                    <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,0,7">
                                                        <Border Width="16" Height="16" CornerRadius="4"><Border.Background><SolidColorBrush Color="{Binding Accent}" /></Border.Background></Border>
                                                        <Border Width="16" Height="16" CornerRadius="4"><Border.Background><SolidColorBrush Color="{Binding Surface}" /></Border.Background></Border>
                                                        <Border Width="16" Height="16" CornerRadius="4"><Border.Background><SolidColorBrush Color="{Binding Text}" /></Border.Background></Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold">
                                                        <TextBlock.Foreground><SolidColorBrush Color="{Binding Text}" /></TextBlock.Foreground>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Panel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Classes="secondary small" x:Name="AboutLine" />
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Diagnostics ===== -->
        <ScrollViewer x:Name="DiagnosticsScroll" Grid.Row="1" IsVisible="{Binding IsDiagnostics}" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,26,28,28" MaxWidth="780" DataContext="{Binding Diagnostics}" x:DataType="vm:DiagnosticsViewModel" Spacing="18">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="title" Text="Diagnostics" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button x:Name="DiagnosticsAgain" Classes="quiet" Content="Look again" Command="{Binding LookAgain}" />
                        <Button x:Name="DiagnosticsCopy" Content="Copy for a bug report" Command="{Binding Copy}" IsEnabled="{Binding Known}" />
                    </StackPanel>
                </Grid>
                <TextBlock Classes="secondary" Text="Asking the stream program…" IsVisible="{Binding Looking}" />
                <Border IsVisible="{Binding HasProblem}" Padding="16,12" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Bad}" Background="{DynamicResource Surface}">
                    <TextBlock Text="{Binding Problem}" TextWrapping="Wrap" />
                </Border>

                <Border Classes="card" IsVisible="{Binding Known}">
                    <StackPanel>
                        <TextBlock Classes="section" Text="This computer" />
                        <TextBlock Text="Decoding" Margin="0,16,0,0" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource Good}" IsVisible="{Binding DecodesOnCard}" />
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{DynamicResource Resting}" IsVisible="{Binding !DecodesOnCard}" />
                            <TextBlock x:Name="DecodingLine" Classes="secondary" Text="{Binding Decoding}" TextWrapping="Wrap" MaxWidth="680" />
                        </StackPanel>
                        <Border Classes="rule" />
                        <TextBlock Text="Graphics" />
                        <TextBlock Classes="secondary" Text="{Binding Devices}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <Border Classes="rule" />
                        <TextBlock Text="Versions" />
                        <TextBlock Classes="secondary" Text="{Binding Versions}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Classes="card" IsVisible="{Binding Known}">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="section" Text="{Binding LastSessionTitle}" VerticalAlignment="Center" />
                            <Button x:Name="OpenLogsButton" Grid.Column="1" Classes="quiet" Content="Open the log folder" Command="{Binding OpenLogs}" IsVisible="{Binding HasLogs}" />
                        </Grid>
                        <TextBlock Classes="secondary small" Text="What the stream program said when it ended: how the pictures came, how smooth they were, and what the console asked of the connection."
                                   TextWrapping="Wrap" Margin="0,6,0,10" IsVisible="{Binding HasLastSession}" />
                        <TextBox x:Name="LastSessionBox" Classes="report" Text="{Binding LastSession}" IsReadOnly="True" IsVisible="{Binding HasLastSession}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Adding a console ===== -->
        <ScrollViewer x:Name="AddScroll" Grid.Row="1" IsVisible="{Binding IsAddConsole}" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,26,28,28" MaxWidth="660">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="title" Text="Add a console" />
                    <Button Grid.Column="1" Classes="quiet" Content="Cancel" Command="{Binding GoHome}" />
                </Grid>

                <StackPanel DataContext="{Binding AddConsole}" x:DataType="vm:AddConsoleViewModel" Margin="0,18,0,0">
                    <!-- 1: which console -->
                    <Border Classes="card" IsVisible="{Binding IsStep1}">
                        <StackPanel>
                            <TextBlock Classes="secondary small" Text="STEP 1 OF 3" />
                            <TextBlock Classes="section" Text="Which console?" Margin="0,4,0,0" />
                            <TextBlock Classes="secondary" Margin="0,6,0,16" Text="The console must be on, and on the same network as this computer." />
                            <ItemsControl x:Name="FoundList" ItemsSource="{Binding Found}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:FoundConsole">
                                        <Button Classes="row first" Command="{Binding $parent[ItemsControl].((vm:AddConsoleViewModel)DataContext).Choose}" CommandParameter="{Binding}">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                                    <TextBlock Classes="secondary small" Text="{Binding Address}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Border Classes="badge" IsVisible="{Binding Registered}"><TextBlock Text="Already added" FontSize="12" Foreground="{DynamicResource TextSecondary}" /></Border>
                                                    <Border Classes="badge"><TextBlock Text="{Binding Kind}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" /></Border>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Classes="secondary" Text="Looking for consoles…" IsVisible="{Binding Searching}" />
                            <TextBlock Classes="secondary" Text="No console answered. Some networks do not pass the question on: type the console's address below." IsVisible="{Binding NothingFound}" />
                            <Button Classes="quiet" Content="Look again" Command="{Binding Search}" HorizontalAlignment="Left" Margin="-10,6,0,0" />
                            <Border Classes="rule" />
                            <TextBlock Text="Or its address" />
                            <TextBlock Classes="secondary small" Text="On the console: Settings, Network, View Connection Status." Margin="0,2,0,8" />
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox x:Name="AddressBox" Text="{Binding Address}" PlaceholderText="192.168.1.20" />
                                <Button Grid.Column="1" Content="Use this address" Command="{Binding UseAddress}" Margin="10,0,0,0" />
                            </Grid>
                            <!-- The address's keys, for whoever sits there with a controller and no keyboard. -->
                            <UniformGrid x:Name="AddressPad" Columns="3" Width="250" HorizontalAlignment="Left" Margin="-4,10,-4,0"
                                         IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ControllerInUse}">
                                <Button Classes="key" Content="1" Command="{Binding AddressKey}" CommandParameter="1" />
                                <Button Classes="key" Content="2" Command="{Binding AddressKey}" CommandParameter="2" />
                                <Button Classes="key" Content="3" Command="{Binding AddressKey}" CommandParameter="3" />
                                <Button Classes="key" Content="4" Command="{Binding AddressKey}" CommandParameter="4" />
                                <Button Classes="key" Content="5" Command="{Binding AddressKey}" CommandParameter="5" />
                                <Button Classes="key" Content="6" Command="{Binding AddressKey}" CommandParameter="6" />
                                <Button Classes="key" Content="7" Command="{Binding AddressKey}" CommandParameter="7" />
                                <Button Classes="key" Content="8" Command="{Binding AddressKey}" CommandParameter="8" />
                                <Button Classes="key" Content="9" Command="{Binding AddressKey}" CommandParameter="9" />
                                <Button Classes="key" Content="." Command="{Binding AddressKey}" CommandParameter="." />
                                <Button Classes="key" Content="0" Command="{Binding AddressKey}" CommandParameter="0" />
                                <Button Classes="key" Command="{Binding AddressErase}" ToolTip.Tip="Erase the last character">
                                    <Path Data="M7.5 1 H21 V15 H7.5 L1 8 Z M11 5 L17 11 M17 5 L11 11" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6" StrokeJoin="Round" StrokeLineCap="Round" Width="22" Height="16" />
                                </Button>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- 2: which account -->
                    <Border Classes="card" IsVisible="{Binding IsStep2}">
                        <StackPanel>
                            <TextBlock Classes="secondary small" Text="STEP 2 OF 3" />
                            <TextBlock Classes="section" Text="Your PSN account" Margin="0,4,0,0" />
                            <TextBlock Classes="secondary" Margin="0,6,0,16"
                                       Text="A console registers a computer for one PSN account. Sign in, and the account is taken from the sign-in: you type your password on Sony's own page, and this app keeps nothing but the account's ID." />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button x:Name="SignInButton" Classes="primary big" Content="Sign in with PSN" Command="{Binding SignIn}" />
                                <TextBlock Classes="secondary" Text="Waiting for the sign-in…" IsVisible="{Binding SigningIn}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Classes="quiet" Content="Sign in with my own browser instead" Command="{Binding OpenInBrowser}" HorizontalAlignment="Left" Margin="-10,8,0,0"
                                    IsVisible="{Binding !ShowPaste}" />

                            <!-- The other road: the user's own browser, and the address it ends on. -->
                            <StackPanel IsVisible="{Binding ShowPaste}" Margin="0,16,0,0">
                                <TextBlock Text="In your browser" />
                                <TextBlock Classes="secondary small" Margin="0,2,0,8"
                                           Text="Sign in on the page that opened. It ends on a nearly empty page that says &quot;redirect&quot;: copy that page's address and come back here. It is taken from the clipboard by itself; or paste it below." />
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox x:Name="PastedBox" Text="{Binding Pasted}" PlaceholderText="https://remoteplay.dl.playstation.net/remoteplay/redirect?code=…" />
                                    <Button x:Name="UsePastedButton" Grid.Column="1" Content="Use it" Command="{Binding UsePasted}" Margin="10,0,0,0" />
                                </Grid>
                            </StackPanel>

                            <Border Classes="rule" />
                            <TextBlock Text="Or type the account ID" />
                            <TextBlock Classes="secondary small" Margin="0,2,0,8" Text="A long number, or the twelve characters the same number is also written as. It is asked once and kept on this computer." />
                            <TextBox x:Name="AccountBox" Text="{Binding AccountId}" PlaceholderText="Account ID" MaxWidth="340" HorizontalAlignment="Left" Width="340" />
                            <!-- The account ID's keys: its long number, digit by digit. -->
                            <UniformGrid x:Name="AccountPad" Columns="3" Width="250" HorizontalAlignment="Left" Margin="-4,10,-4,0"
                                         IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ControllerInUse}">
                                <Button Classes="key" Content="1" Command="{Binding AccountKey}" CommandParameter="1" />
                                <Button Classes="key" Content="2" Command="{Binding AccountKey}" CommandParameter="2" />
                                <Button Classes="key" Content="3" Command="{Binding AccountKey}" CommandParameter="3" />
                                <Button Classes="key" Content="4" Command="{Binding AccountKey}" CommandParameter="4" />
                                <Button Classes="key" Content="5" Command="{Binding AccountKey}" CommandParameter="5" />
                                <Button Classes="key" Content="6" Command="{Binding AccountKey}" CommandParameter="6" />
                                <Button Classes="key" Content="7" Command="{Binding AccountKey}" CommandParameter="7" />
                                <Button Classes="key" Content="8" Command="{Binding AccountKey}" CommandParameter="8" />
                                <Button Classes="key" Content="9" Command="{Binding AccountKey}" CommandParameter="9" />
                                <Panel />
                                <Button Classes="key" Content="0" Command="{Binding AccountKey}" CommandParameter="0" />
                                <Button Classes="key" Command="{Binding AccountErase}" ToolTip.Tip="Erase the last digit">
                                    <Path Data="M7.5 1 H21 V15 H7.5 L1 8 Z M11 5 L17 11 M17 5 L11 11" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6" StrokeJoin="Round" StrokeLineCap="Round" Width="22" Height="16" />
                                </Button>
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,22,0,0">
                                <Button x:Name="NextButton" Content="Next" Command="{Binding Next}" Padding="26,11" />
                                <Button Classes="quiet" Content="Back" Command="{Binding Back}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 3: the PIN -->
                    <Border Classes="card" IsVisible="{Binding IsStep3}">
                        <StackPanel>
                            <TextBlock Classes="secondary small" Text="STEP 3 OF 3" />
                            <TextBlock Classes="section" Margin="0,4,0,0">
                                <Run Text="The PIN that " /><Run Text="{Binding ChosenName}" /><Run Text=" shows" />
                            </TextBlock>
                            <TextBlock Classes="small" Text="Signed in: the account was taken from your sign-in." Foreground="{DynamicResource Good}" IsVisible="{Binding SignedIn}" Margin="0,6,0,0" />
                            <TextBlock Classes="secondary" Margin="0,6,0,16"
                                       Text="On the console, open Settings, System, Remote Play, Link Device. It shows eight digits for five minutes: type them here." />
                            <TextBox x:Name="PinBox" Classes="pin" Text="{Binding Pin}" MaxLength="9" PlaceholderText="0000 0000" />
                            <!-- The PIN's keys, for whoever sits there with a controller and no keyboard. -->
                            <UniformGrid x:Name="PinPad" Columns="3" Width="250" HorizontalAlignment="Left" Margin="-4,10,-4,0"
                                         IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ControllerInUse}">
                                <Button Classes="key first" Content="1" Command="{Binding PinDigit}" CommandParameter="1" />
                                <Button Classes="key" Content="2" Command="{Binding PinDigit}" CommandParameter="2" />
                                <Button Classes="key" Content="3" Command="{Binding PinDigit}" CommandParameter="3" />
                                <Button Classes="key" Content="4" Command="{Binding PinDigit}" CommandParameter="4" />
                                <Button Classes="key" Content="5" Command="{Binding PinDigit}" CommandParameter="5" />
                                <Button Classes="key" Content="6" Command="{Binding PinDigit}" CommandParameter="6" />
                                <Button Classes="key" Content="7" Command="{Binding PinDigit}" CommandParameter="7" />
                                <Button Classes="key" Content="8" Command="{Binding PinDigit}" CommandParameter="8" />
                                <Button Classes="key" Content="9" Command="{Binding PinDigit}" CommandParameter="9" />
                                <Panel />
                                <Button Classes="key" Content="0" Command="{Binding PinDigit}" CommandParameter="0" />
                                <Button x:Name="PinEraseKey" Classes="key" Command="{Binding PinErase}" ToolTip.Tip="Erase the last digit">
                                    <Path Data="M7.5 1 H21 V15 H7.5 L1 8 Z M11 5 L17 11 M17 5 L11 11" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.6" StrokeJoin="Round" StrokeLineCap="Round" Width="22" Height="16" />
                                </Button>
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,22,0,0">
                                <Button x:Name="RegisterButton" Classes="primary big" Content="Register" Command="{Binding Register}" />
                                <Button Classes="quiet" Content="Back" Command="{Binding Back}" />
                                <TextBlock Classes="secondary" Text="Asking the console…" IsVisible="{Binding Working}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border IsVisible="{Binding HasError}" Margin="0,14,0,0" Padding="16,12" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Bad}" Background="{DynamicResource Surface}">
                        <TextBlock x:Name="AddError" Text="{Binding Error}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== A session that runs ===== -->
        <Border Grid.Row="2" IsVisible="{Binding Playing}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Accent}" BorderThickness="0,2,0,0" Padding="28,14">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="SessionTitle" Text="{Binding SessionTitle}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="SessionLine" Classes="secondary small" Text="{Binding SessionLine}" Margin="0,3,0,0" MaxLines="2" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button x:Name="StopButton" Grid.Column="1" Content="End the session" Command="{Binding Stop}" Margin="16,0,0,0" />
            </Grid>
        </Border>

        <!-- ===== What just happened ===== -->
        <Border Grid.Row="3" IsVisible="{Binding HasNotice}" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="28,12">
            <StackPanel>
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Panel Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Ellipse Fill="{DynamicResource Bad}" IsVisible="{Binding NoticeIsError}" />
                        <Ellipse Fill="{DynamicResource Good}" IsVisible="{Binding !NoticeIsError}" />
                    </Panel>
                    <TextBlock x:Name="NoticeText" Grid.Column="1" Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Classes="quiet" Content="What the program said" Command="{Binding ToggleReport}" IsVisible="{Binding HasReport}" />
                    <Button Grid.Column="3" Classes="quiet" Content="Dismiss" Command="{Binding DismissNotice}" />
                </Grid>
                <TextBox Classes="report" Text="{Binding Report}" IsReadOnly="True" IsVisible="{Binding ShowReport}" Margin="0,10,0,4" />
            </StackPanel>
        </Border>

        <!-- ===== The controller a session would use ===== -->
        <Border Grid.Row="4" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="28,9">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <Panel Width="24" Height="17" VerticalAlignment="Center">
                    <Path Data="M7 0 H17 A7 7 0 0 1 24 7 V11.5 A5 5 0 0 1 15.3 14.9 L14 13 H10 L8.7 14.9 A5 5 0 0 1 0 11.5 V7 A7 7 0 0 1 7 0 Z"
                          Fill="{DynamicResource TextSecondary}" IsVisible="{Binding !HasController}" Opacity="0.55" />
                    <Path Data="M7 0 H17 A7 7 0 0 1 24 7 V11.5 A5 5 0 0 1 15.3 14.9 L14 13 H10 L8.7 14.9 A5 5 0 0 1 0 11.5 V7 A7 7 0 0 1 7 0 Z"
                          Fill="{DynamicResource Good}" IsVisible="{Binding HasController}" />
                </Panel>
                <TextBlock x:Name="ControllerLine" Grid.Column="1" Text="{Binding ControllerLine}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="13" />
                <Panel Grid.Column="2" Margin="18,0,0,0" VerticalAlignment="Center" IsVisible="{Binding HasControllerNote}">
                    <TextBlock x:Name="ControllerNote" Classes="secondary small" Text="{Binding ControllerNote}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right"
                               IsVisible="{Binding !ControllerBatteryLow}" />
                    <TextBlock Classes="small" Text="{Binding ControllerNote}" Foreground="{DynamicResource Resting}" HorizontalAlignment="Right" IsVisible="{Binding ControllerBatteryLow}" />
                </Panel>
                <!-- What the controller's buttons do here, called what its maker calls them. -->
                <StackPanel x:Name="Hints" Grid.Column="3" Orientation="Horizontal" Spacing="18" Margin="24,0,0,0" VerticalAlignment="Center" IsVisible="{Binding HasController}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Border Classes="pad">
                            <Panel>
                                <Path Data="M1 1 L9 9 M9 1 L1 9" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.5" StrokeLineCap="Round" Width="10" Height="10" IsVisible="{Binding Buttons.Shapes}" />
                                <TextBlock x:Name="AcceptName" Classes="padname" Text="{Binding Buttons.Accept}" IsVisible="{Binding !Buttons.Shapes}" />
                            </Panel>
                        </Border>
                        <TextBlock Classes="secondary small" Text="Choose" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel x:Name="BackHint" Orientation="Horizontal" Spacing="7" IsVisible="{Binding CanGoBack}">
                        <Border Classes="pad">
                            <Panel>
                                <Ellipse Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.5" Width="10" Height="10" IsVisible="{Binding Buttons.Shapes}" />
                                <TextBlock Classes="padname" Text="{Binding Buttons.Back}" IsVisible="{Binding !Buttons.Shapes}" />
                            </Panel>
                        </Border>
                        <TextBlock Classes="secondary small" Text="Back" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Border Classes="pad wide"><TextBlock x:Name="PreviousName" Classes="padname" Text="{Binding Buttons.Previous}" /></Border>
                        <Border Classes="pad wide"><TextBlock Classes="padname" Text="{Binding Buttons.Next}" /></Border>
                        <TextBlock Classes="secondary small" Text="Pages" VerticalAlignment="Center" Margin="2,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
    </LayoutTransformControl>
</Window>
