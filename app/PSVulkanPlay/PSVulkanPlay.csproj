<Project Sdk="Microsoft.NET.Sdk">

  <!-- The app around the stream: consoles, settings, setting up. It runs the
       native program (ps-vulkanplay) for everything a console is asked, the
       stream window included; nothing of the protocol lives here. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PSVulkanPlay</AssemblyName>
    <RootNamespace>PSVulkanPlay</RootNamespace>
    <Product>PS VulkanPlay</Product>
    <AssemblyTitle>PS VulkanPlay</AssemblyTitle>
    <Version>0.0.5</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <!-- The window for the PSN sign-in page: the system's own web engine (WebKitGTK), when it is there. -->
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- What Steam's library pictures are made from (Core/Steam.cs), readable without the toolkit started. -->
    <EmbeddedResource Include="..\..\assets\banner.png" LogicalName="banner.png" />
    <EmbeddedResource Include="Assets\icon.png" LogicalName="icon.png" />
    <InternalsVisibleTo Include="PSVulkanPlay.Tests" />
  </ItemGroup>

</Project>
